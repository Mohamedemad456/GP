{
  "uid": "ml-service-overview",
  "title": "ML Pricing Engine — Service Dashboard",
  "tags": ["ml-service", "prometheus", "pricing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Comprehensive observability dashboard for the ML Pricing Engine: request volume, confidence quality, error rates, latency, and endpoint breakdown.",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "━ Overview",
      "type": "row",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "Total Predictions",
      "description": "Cumulative count of all successful prediction requests since service start.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(prediction_requests_total)", "legendFormat": "Total Predictions" }
      ]
    },
    {
      "id": 2,
      "title": "Success Rate",
      "description": "Percentage of HTTP requests returning 2xx status codes.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"2..\"}[5m])) / sum(rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "Success Rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "description": "Prediction errors as a percentage of total prediction requests. Green = no errors, Red = high error rate.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prediction_errors_total[5m])) / sum(rate(prediction_requests_total[5m]))",
          "legendFormat": "Error Rate"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Errors",
      "description": "Cumulative count of prediction errors since service start.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(prediction_errors_total)", "legendFormat": "Total Errors" }
      ]
    },
    {
      "id": 5,
      "title": "Batch Requests",
      "description": "Cumulative count of batch prediction requests.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(batch_prediction_requests_total)", "legendFormat": "Batch Requests" }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Requests",
      "description": "Total HTTP requests served since service start.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "super-light-blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#8ab8ff", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(http_request_duration_seconds_count)", "legendFormat": "HTTP Requests" }
      ]
    },
    {
      "id": 200,
      "title": "━ Confidence & Quality",
      "type": "row",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 7,
      "title": "Confidence Breakdown",
      "description": "Total predictions by confidence label: High (MAPE ≤14%), Medium (MAPE 14-18%), Low (MAPE >18%).",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "High Confidence" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Medium Confidence" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Low Confidence" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "vertical",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true
      },
      "targets": [
        { "refId": "A", "expr": "sum(prediction_requests_total{confidence=\"high\"})", "legendFormat": "High Confidence" },
        { "refId": "B", "expr": "sum(prediction_requests_total{confidence=\"medium\"})", "legendFormat": "Medium Confidence" },
        { "refId": "C", "expr": "sum(prediction_requests_total{confidence=\"low\"})", "legendFormat": "Low Confidence" }
      ]
    },
    {
      "id": 8,
      "title": "Low Confidence Rate",
      "description": "Percentage of predictions with low confidence. High values may indicate model drift or unusual input distribution.",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 6, "w": 4, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.3 }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prediction_requests_total{confidence=\"low\"}[5m])) / sum(rate(prediction_requests_total[5m]))",
          "legendFormat": "Low Confidence %"
        }
      ]
    },
    {
      "id": 9,
      "title": "Prediction Request Rate by Confidence",
      "description": "Requests per second broken down by confidence label over time.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "high" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "medium" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "low" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (confidence) (rate(prediction_requests_total[5m]))",
          "legendFormat": "{{confidence}}"
        }
      ]
    },
    {
      "id": 300,
      "title": "━ Traffic & Endpoints",
      "type": "row",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 10,
      "title": "Request Rate by Endpoint",
      "description": "Requests per second broken down by endpoint: Single Prediction, Batch Prediction, Health Check.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Single Prediction" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Batch Prediction" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Health Check" },
            "properties": [{ "id": "color", "value": { "fixedColor": "super-light-green", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{path=\"/api/v1/predict\"}[5m]))",
          "legendFormat": "Single Prediction"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_request_duration_seconds_count{path=\"/api/v1/predict/batch\"}[5m]))",
          "legendFormat": "Batch Prediction"
        },
        {
          "refId": "C",
          "expr": "sum(rate(http_request_duration_seconds_count{path=\"/health\"}[5m]))",
          "legendFormat": "Health Check"
        }
      ]
    },
    {
      "id": 11,
      "title": "Requests by Status Code",
      "description": "HTTP request rate grouped by status code family: 2xx (Success), 4xx (Client Error), 5xx (Server Error).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 25, "lineWidth": 2, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "2xx.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "4xx.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "5xx.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"2..\"}[5m]))",
          "legendFormat": "2xx Success"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"4..\"}[5m]))",
          "legendFormat": "4xx Client Error"
        },
        {
          "refId": "C",
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx Server Error"
        }
      ]
    },
    {
      "id": 12,
      "title": "Prediction Volume by Endpoint Type",
      "description": "Total prediction requests by endpoint type (single vs batch).",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 21, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Single" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Batch" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "refId": "A", "expr": "sum(prediction_requests_by_endpoint_total{endpoint=\"single\"})", "legendFormat": "Single" },
        { "refId": "B", "expr": "sum(prediction_requests_by_endpoint_total{endpoint=\"batch\"})", "legendFormat": "Batch" }
      ]
    },
    {
      "id": 13,
      "title": "Detailed Path / Status Breakdown",
      "description": "Request rate by exact path and status code for debugging.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 21, "w": 16, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path, status_code) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{path}} → {{status_code}}"
        }
      ]
    },
    {
      "id": 400,
      "title": "━ Latency & Performance",
      "type": "row",
      "gridPos": { "x": 0, "y": 25, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 14,
      "title": "HTTP Request Latency — p50 / p95 / p99",
      "description": "HTTP request latency percentiles across all endpoints. p50 = median, p95 = 95th percentile, p99 = 99th percentile.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Median (p50)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "95th Percentile (p95)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "99th Percentile (p99)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Median (p50)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "95th Percentile (p95)"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "99th Percentile (p99)"
        }
      ]
    },
    {
      "id": 15,
      "title": "Prediction Latency — p50 / p95 / p99",
      "description": "ML prediction processing latency percentiles. This measures the time spent in model inference, SHAP, and confidence computation only.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Median (p50)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "95th Percentile (p95)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "99th Percentile (p99)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(prediction_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Median (p50)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(prediction_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "95th Percentile (p95)"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(prediction_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "99th Percentile (p99)"
        }
      ]
    },
    {
      "id": 16,
      "title": "Prediction Error Trend",
      "description": "Prediction errors per second over time. Should be at or near zero. Any spike indicates model or service issues.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prediction_errors_total[5m]))",
          "legendFormat": "Prediction Errors / sec"
        }
      ]
    },
    {
      "id": 17,
      "title": "Overall Request Rate",
      "description": "Total HTTP request rate across all endpoints.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "Total Requests / sec"
        }
      ]
    }
  ]
}